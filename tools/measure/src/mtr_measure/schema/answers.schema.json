{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelsthatrun.dev/schema/answers.schema.json",
  "$comment": "Generated from ModelsThatRun's schema package. Do not edit by hand.",
  "title": "Answers to a prompt set",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "answers"
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "size": {
      "type": "string",
      "minLength": 1
    },
    "weights": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "prompt_set": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "task",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "release",
        "build",
        "binary_sha256"
      ],
      "additionalProperties": false
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "answers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "finish": {
            "type": "string",
            "enum": [
              "stop",
              "length"
            ]
          }
        },
        "required": [
          "prompt",
          "text",
          "tokens",
          "finish"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "task",
    "model",
    "size",
    "weights",
    "prompt_set",
    "settings",
    "engine",
    "generated",
    "answers"
  ],
  "additionalProperties": false
}
