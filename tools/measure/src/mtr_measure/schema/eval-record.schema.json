{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelsthatrun.dev/schema/eval-record.schema.json",
  "$comment": "Generated from ModelsThatRun's schema package. Do not edit by hand.",
  "title": "Eval record",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "llm"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "size": {
      "type": "string",
      "minLength": 1
    },
    "weights": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "benchmark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Benchmark id in the measuring tool, e.g. coco-val2017-bbox"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Number of images or questions scored"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "What value is, e.g. AP@[.50:.95]"
        },
        "data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of the data the score was computed against: the ground-truth file, or the items as scored"
        }
      },
      "required": [
        "id",
        "name",
        "split",
        "n",
        "metric",
        "data_sha256"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "number",
      "description": "The headline metric, on the scale papers use (e.g. AP 0-100)"
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Everything that affects the score: precision or quantization, evaluator and version, prompts"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "protocol": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "evaluated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "predictions_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of the raw predictions file, kept locally as evidence"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "mtr"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "git commit of the tool checkout, null outside git"
            },
            "dirty": {
              "description": "Whether tools/measure or the model directory had uncommitted changes",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "commit",
            "dirty"
          ],
          "additionalProperties": false
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lock_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of the model environment's uv.lock"
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of each input file, for image models; null for language models"
        }
      },
      "required": [
        "tool",
        "adapter_sha256",
        "lock_sha256",
        "input_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "model",
    "size",
    "weights",
    "benchmark",
    "value",
    "metrics",
    "settings",
    "env",
    "protocol",
    "evaluated",
    "duration_s",
    "predictions_sha256"
  ],
  "additionalProperties": false
}
