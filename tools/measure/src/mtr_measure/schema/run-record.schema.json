{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelsthatrun.dev/schema/run-record.schema.json",
  "$comment": "Generated from ModelsThatRun's schema package. Do not edit by hand.",
  "title": "Run record",
  "type": "object",
  "properties": {
    "kind": {
      "description": "Image models. Language models have llmRunRecord",
      "type": "string",
      "const": "image"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "size": {
      "type": "string",
      "minLength": 1
    },
    "weights": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "file",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "measurement": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "string",
          "enum": [
            "fp32",
            "fp16",
            "bf16"
          ]
        },
        "batch": {
          "type": "number",
          "const": 1
        },
        "input": {
          "type": "string",
          "pattern": "^\\d+x\\d+$"
        },
        "latency_ms": {
          "type": "object",
          "properties": {
            "median": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "p90": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "median",
            "p90"
          ],
          "additionalProperties": false
        },
        "latency_scope": {
          "type": "string",
          "minLength": 1
        },
        "vram_peak_mib": {
          "type": "number",
          "minimum": 0,
          "description": "Device-level NVML peak minus pre-load baseline"
        },
        "torch_max_reserved_mib": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "type": "object",
          "properties": {
            "warmup": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "timed": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "warmup",
            "timed"
          ],
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "properties": {
            "gpu": {
              "type": "string",
              "minLength": 1
            },
            "driver": {
              "type": "string",
              "minLength": 1
            },
            "cuda": {
              "type": "string",
              "minLength": 1
            },
            "torch": {
              "type": "string",
              "minLength": 1
            },
            "python": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "description": "Model package and version, e.g. rfdetr==1.11.2"
            },
            "image_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "baseline_mib": {
              "type": "number",
              "minimum": 0
            },
            "cpu": {
              "description": "CPU model, from /proc/cpuinfo",
              "type": "string"
            },
            "gpu_memory_mib": {
              "description": "Total GPU memory, from NVML",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "compute_capability": {
              "description": "CUDA compute capability, e.g. 8.9",
              "type": "string",
              "pattern": "^\\d+\\.\\d+$"
            },
            "os": {
              "description": "Kernel and C library, e.g. Linux 6.2.6 glibc 2.35",
              "type": "string"
            },
            "power_limit_w": {
              "description": "Enforced GPU power limit in watts, from NVML",
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "power_default_w": {
              "description": "Default GPU power limit in watts, from NVML",
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "gpu",
            "driver",
            "cuda",
            "torch",
            "python",
            "package",
            "image_digest",
            "baseline_mib"
          ],
          "additionalProperties": false
        },
        "measured": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "protocol": {
          "description": "Protocol version (tools/measure/src/mtr_measure/protocol.py); absent means 1",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "runs": {
          "description": "Each independent run. latency_ms holds the medians of these, vram_peak_mib the highest",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "median": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "p90": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "vram_peak_mib": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "median",
              "p90",
              "vram_peak_mib"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "precision",
        "batch",
        "input",
        "latency_ms",
        "latency_scope",
        "vram_peak_mib",
        "iterations",
        "env",
        "measured"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "mtr"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "git commit of the tool checkout, null outside git"
            },
            "dirty": {
              "description": "Whether tools/measure or the model directory had uncommitted changes",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "commit",
            "dirty"
          ],
          "additionalProperties": false
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lock_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of the model environment's uv.lock"
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of each input file, for image models; null for language models"
        }
      },
      "required": [
        "tool",
        "adapter_sha256",
        "lock_sha256",
        "input_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "model",
    "size",
    "weights",
    "measurement"
  ],
  "additionalProperties": false
}
